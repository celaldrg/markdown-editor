  {"section":"list","name":"loose sublist inside a tight list","md":"- a\n  - b\n\n    c\n- d","html":"<ul>\n<li>a\n<ul>\n<li>\n<p>b</p>\n<p>c</p>\n</li>\n</ul>\n</li>\n<li>d</li>\n</ul>\n"},
  {"section":"list","name":"blank lines in fenced code keep the list tight","md":"- a\n- ```\n  b\n\n\n  ```\n- c","html":"<ul>\n<li>a</li>\n<li>\n<pre><code>b\n\n\n</code></pre>\n</li>\n<li>c</li>\n</ul>\n"},
  {"section":"list","name":"items starting with a blank line","md":"-\n  foo\n-\n  ```\n  bar\n  ```\n-\n      baz","html":"<ul>\n<li>foo</li>\n<li>\n<pre><code>bar\n</code></pre>\n</li>\n<li>\n<pre><code>baz\n</code></pre>\n</li>\n</ul>\n"},
  {"section":"list","name":"list directly inside a list item","md":"- - foo","html":"<ul>\n<li>\n<ul>\n<li>foo</li>\n</ul>\n</li>\n</ul>\n"},
