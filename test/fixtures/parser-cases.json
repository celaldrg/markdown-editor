  {"section":"thematic-break","name":"break inside a list item","md":"- foo\n- * * *","html":"<ul>\n<li>foo</li>\n<li>\n<hr>\n</li>\n</ul>\n"},
  {"section":"table","name":"basic table","md":"| foo | bar |\n| --- | --- |\n| baz | bim |","html":"<table>\n<thead>\n<tr>\n<th>foo</th>\n<th>bar</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>baz</td>\n<td>bim</td>\n</tr>\n</tbody>\n</table>\n"},
  {"section":"table","name":"alignment","md":"| abc | defghi |\n:-: | -----------:\nbar | baz","html":"<table>\n<thead>\n<tr>\n<th align=\"center\">abc</th>\n<th align=\"right\">defghi</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td align=\"center\">bar</td>\n<td align=\"right\">baz</td>\n</tr>\n</tbody>\n</table>\n"},
  {"section":"table","name":"left, center, right and none","md":"| a | b | c | d |\n|:--|:-:|--:|---|\n| 1 | 2 | 3 | 4 |","html":"<table>\n<thead>\n<tr>\n<th align=\"left\">a</th>\n<th align=\"center\">b</th>\n<th align=\"right\">c</th>\n<th>d</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td align=\"left\">1</td>\n<td align=\"center\">2</td>\n<td align=\"right\">3</td>\n<td>4</td>\n</tr>\n</tbody>\n</table>\n"},
  {"section":"table","name":"escaped pipes in cells","md":"| f\\|oo  |\n| ------ |\n| b `\\|` az |\n| b **\\|** im |","html":"<table>\n<thead>\n<tr>\n<th>f|oo</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>b <code>|</code> az</td>\n</tr>\n<tr>\n<td>b <strong>|</strong> im</td>\n</tr>\n</tbody>\n</table>\n"},
  {"section":"table","name":"table ends at a block quote","md":"| abc | def |\n| --- | --- |\n| bar | baz |\n> bar","html":"<table>\n<thead>\n<tr>\n<th>abc</th>\n<th>def</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>bar</td>\n<td>baz</td>\n</tr>\n</tbody>\n</table>\n<blockquote>\n<p>bar</p>\n</blockquote>\n"},
  {"section":"table","name":"table ends at a blank line","md":"| abc | def |\n| --- | --- |\n| bar | baz |\nbar\n\nbar","html":"<table>\n<thead>\n<tr>\n<th>abc</th>\n<th>def</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>bar</td>\n<td>baz</td>\n</tr>\n<tr>\n<td>bar</td>\n<td></td>\n</tr>\n</tbody>\n</table>\n<p>bar</p>\n"},
  {"section":"table","name":"header and delimiter must have the same cell count","md":"| abc | def |\n| --- |\n| bar |","html":"<p>| abc | def |\n| --- |\n| bar |</p>\n"},
  {"section":"table","name":"rows are padded and truncated","md":"| abc | def |\n| --- | --- |\n| bar |\n| bar | baz | boo |","html":"<table>\n<thead>\n<tr>\n<th>abc</th>\n<th>def</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>bar</td>\n<td></td>\n</tr>\n<tr>\n<td>bar</td>\n<td>baz</td>\n</tr>\n</tbody>\n</table>\n"},
  {"section":"table","name":"table without body rows","md":"| abc | def |\n| --- | --- |","html":"<table>\n<thead>\n<tr>\n<th>abc</th>\n<th>def</th>\n</tr>\n</thead>\n</table>\n"},
  {"section":"table","name":"outer pipes are optional","md":"a | b\n--|--\n1 | 2","html":"<table>\n<thead>\n<tr>\n<th>a</th>\n<th>b</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>1</td>\n<td>2</td>\n</tr>\n</tbody>\n</table>\n"},
  {"section":"table","name":"table interrupts a paragraph","md":"Intro text\n| a | b |\n| - | - |\n| 1 | 2 |","html":"<p>Intro text</p>\n<table>\n<thead>\n<tr>\n<th>a</th>\n<th>b</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>1</td>\n<td>2</td>\n</tr>\n</tbody>\n</table>\n"},
  {"section":"table","name":"table inside a quote","md":"> | a |\n> | - |\n> | 1 |","html":"<blockquote>\n<table>\n<thead>\n<tr>\n<th>a</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>1</td>\n</tr>\n</tbody>\n</table>\n</blockquote>\n"},
