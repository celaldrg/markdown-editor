  {"section":"image","name":"escaped image marker","md":"\\![foo]","html":"<p>![foo]</p>\n"},
  {"section":"thematic-break","name":"three kinds","md":"***\n---\n___","html":"<hr>\n<hr>\n<hr>\n"},
  {"section":"thematic-break","name":"spaces between the characters","md":" - - -\n\n *  *  *","html":"<hr>\n<hr>\n"},
  {"section":"thematic-break","name":"two characters are not enough","md":"--\n**\n__","html":"<p>--\n**\n__</p>\n"},
