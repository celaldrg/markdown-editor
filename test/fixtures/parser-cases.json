[
  {"section":"atx-heading","name":"levels 1 to 6","md":"# h1\n## h2\n### h3\n#### h4\n##### h5\n###### h6","html":"<h1 id=\"h1\">h1</h1>\n<h2 id=\"h2\">h2</h2>\n<h3 id=\"h3\">h3</h3>\n<h4 id=\"h4\">h4</h4>\n<h5 id=\"h5\">h5</h5>\n<h6 id=\"h6\">h6</h6>\n"},
  {"section":"atx-heading","name":"seven hashes is a paragraph","md":"####### foo","html":"<p>####### foo</p>\n"},
  {"section":"atx-heading","name":"a space is required after the hashes","md":"#5 bolt\n\n#hashtag","html":"<p>#5 bolt</p>\n<p>#hashtag</p>\n"},
  {"section":"atx-heading","name":"escaped hash is literal","md":"\\## foo","html":"<p>## foo</p>\n"},
  {"section":"atx-heading","name":"closing sequence is removed, a glued one is kept","md":"## foo ##\n# bar#","html":"<h2 id=\"foo\">foo</h2>\n<h1 id=\"bar\">bar#</h1>\n"},
  {"section":"atx-heading","name":"up to three leading spaces and inline content","md":"   ### foo *bar*","html":"<h3 id=\"foo-bar\">foo <em>bar</em></h3>\n"},
  {"section":"atx-heading","name":"four spaces make indented code","md":"    # foo","html":"<pre><code># foo\n</code></pre>\n"},
  {"section":"atx-heading","name":"empty headings get a fallback id","md":"#\n\n### ###","html":"<h1 id=\"section\"></h1>\n<h3 id=\"section-1\"></h3>\n"},
  {"section":"atx-heading","name":"duplicate headings get unique ids","md":"# Intro\n## Intro\n### Intro","html":"<h1 id=\"intro\">Intro</h1>\n<h2 id=\"intro-1\">Intro</h2>\n<h3 id=\"intro-2\">Intro</h3>\n"},
  {"section":"atx-heading","name":"heading interrupts a paragraph","md":"Foo bar\n# baz\nBar foo","html":"<p>Foo bar</p>\n<h1 id=\"baz\">baz</h1>\n<p>Bar foo</p>\n"},
  {"section":"setext-heading","name":"level 1 and level 2","md":"Foo *bar*\n=========\n\nFoo *bar*\n---------","html":"<h1 id=\"foo-bar\">Foo <em>bar</em></h1>\n<h2 id=\"foo-bar-1\">Foo <em>bar</em></h2>\n"},
  {"section":"setext-heading","name":"multi-line content","md":"Foo\nbar\n===","html":"<h1 id=\"foo-bar\">Foo\nbar</h1>\n"},
  {"section":"setext-heading","name":"underline without a paragraph","md":"===\n\n---","html":"<p>===</p>\n<hr>\n"},
  {"section":"setext-heading","name":"dashes after a paragraph make a heading","md":"Foo\n---\nbar","html":"<h2 id=\"foo\">Foo</h2>\n<p>bar</p>\n"},
  {"section":"setext-heading","name":"underline cannot be a lazy line of a quote","md":"> foo\n---","html":"<blockquote>\n<p>foo</p>\n</blockquote>\n<hr>\n"},
  {"section":"paragraph","name":"soft breaks and blank lines","md":"aaa\nbbb\n\nccc","html":"<p>aaa\nbbb</p>\n<p>ccc</p>\n"},
  {"section":"paragraph","name":"leading spaces are stripped","md":"  aaa\n bbb","html":"<p>aaa\nbbb</p>\n"},
  {"section":"paragraph","name":"final spaces are stripped","md":"aaa     \nbbb     ","html":"<p>aaa<br>\nbbb</p>\n"},
  {"section":"emphasis","name":"asterisks and underscores","md":"*foo bar* _foo bar_","html":"<p><em>foo bar</em> <em>foo bar</em></p>\n"},
  {"section":"emphasis","name":"strong emphasis","md":"**foo bar** __foo bar__","html":"<p><strong>foo bar</strong> <strong>foo bar</strong></p>\n"},
  {"section":"emphasis","name":"intraword underscores are literal, asterisks are not","md":"foo_bar_baz foo*bar*baz","html":"<p>foo_bar_baz foo<em>bar</em>baz</p>\n"},
  {"section":"emphasis","name":"delimiter followed by whitespace does not open","md":"a * foo bar*","html":"<p>a * foo bar*</p>\n"},
  {"section":"emphasis","name":"emphasis inside strong","md":"**foo *bar* baz**","html":"<p><strong>foo <em>bar</em> baz</strong></p>\n"},
  {"section":"emphasis","name":"triple delimiters","md":"***strong emph***","html":"<p><em><strong>strong emph</strong></em></p>\n"},
  {"section":"emphasis","name":"rule of three","md":"*foo**bar**baz*","html":"<p><em>foo<strong>bar</strong>baz</em></p>\n"},
  {"section":"emphasis","name":"unmatched inner delimiters stay literal","md":"*foo**bar*","html":"<p><em>foo**bar</em></p>\n"},
  {"section":"emphasis","name":"leftover opener is literal","md":"**foo*","html":"<p>*<em>foo</em></p>\n"},
  {"section":"emphasis","name":"nested strong","md":"__foo, __bar__, baz__","html":"<p><strong>foo, <strong>bar</strong>, baz</strong></p>\n"},
  {"section":"emphasis","name":"punctuation flanking","md":"*(*foo*)*","html":"<p><em>(<em>foo</em>)</em></p>\n"},
  {"section":"emphasis","name":"underscore after punctuation","md":"foo-_(bar)_","html":"<p>foo-<em>(bar)</em></p>\n"},
  {"section":"strikethrough","name":"double and single tildes","md":"~~Hi~~ Hello, ~there~ world!","html":"<p><del>Hi</del> Hello, <del>there</del> world!</p>\n"},
  {"section":"strikethrough","name":"three tildes are literal","md":"a ~~~b~~~ c","html":"<p>a ~~~b~~~ c</p>\n"},
  {"section":"strikethrough","name":"opener and closer must match","md":"~~foo~","html":"<p>~~foo~</p>\n"},
  {"section":"strikethrough","name":"emphasis inside strikethrough","md":"~~**bold** gone~~","html":"<p><del><strong>bold</strong> gone</del></p>\n"},
  {"section":"inline-code","name":"simple code span","md":"`foo`","html":"<p><code>foo</code></p>\n"},
  {"section":"inline-code","name":"double backticks around a backtick","md":"`` foo ` bar ``","html":"<p><code>foo ` bar</code></p>\n"},
  {"section":"inline-code","name":"one space is stripped on each side","md":"` `` `","html":"<p><code>``</code></p>\n"},
  {"section":"inline-code","name":"no emphasis inside code","md":"`*foo*`","html":"<p><code>*foo*</code></p>\n"},
  {"section":"inline-code","name":"backslashes are literal in code","md":"`foo\\bar`","html":"<p><code>foo\\bar</code></p>\n"},
  {"section":"inline-code","name":"unmatched backticks are literal","md":"```foo``","html":"<p>```foo``</p>\n"},
  {"section":"inline-code","name":"line endings become spaces","md":"`foo\nbar`","html":"<p><code>foo bar</code></p>\n"},
  {"section":"inline-code","name":"html is escaped in code","md":"`<a href=\"x\">`","html":"<p><code>&lt;a href=&quot;x&quot;&gt;</code></p>\n"},
  {"section":"fenced-code","name":"backtick fence with language class","md":"```js\nlet a = 1;\n```","html":"<pre><code class=\"language-js\">let a = 1;\n</code></pre>\n"},
  {"section":"fenced-code","name":"tilde fence escapes html","md":"~~~\n<\n >\n~~~","html":"<pre><code>&lt;\n &gt;\n</code></pre>\n"},
  {"section":"fenced-code","name":"only the first word of the info string","md":"``` ruby startline=3\ndef foo\n```","html":"<pre><code class=\"language-ruby\">def foo\n</code></pre>\n"},
  {"section":"fenced-code","name":"closing fence must be long enough","md":"````\naaa\n```\n``````","html":"<pre><code>aaa\n```\n</code></pre>\n"},
  {"section":"fenced-code","name":"unclosed fence runs to the end","md":"`````\n\n```\naaa","html":"<pre><code>\n```\naaa\n</code></pre>\n"},
  {"section":"fenced-code","name":"fence indentation is removed from content","md":"   ```\n   aaa\n    aaa\n  aaa\n   ```","html":"<pre><code>aaa\n aaa\naaa\n</code></pre>\n"},
  {"section":"fenced-code","name":"fence interrupts a paragraph","md":"foo\n```\nbar\n```\nbaz","html":"<p>foo</p>\n<pre><code>bar\n</code></pre>\n<p>baz</p>\n"},
  {"section":"fenced-code","name":"empty code block","md":"```\n```","html":"<pre><code></code></pre>\n"},
  {"section":"fenced-code","name":"language with symbols","md":"```c++ main\nint x;\n```","html":"<pre><code class=\"language-c++\">int x;\n</code></pre>\n"},
  {"section":"fenced-code","name":"backtick fence info cannot contain backticks","md":"``` aa ```\nfoo","html":"<p><code>aa</code>\nfoo</p>\n"},
  {"section":"indented-code","name":"indented code keeps extra indentation","md":"    a simple\n      indented code block","html":"<pre><code>a simple\n  indented code block\n</code></pre>\n"},
  {"section":"indented-code","name":"cannot interrupt a paragraph","md":"Foo\n    bar","html":"<p>Foo\nbar</p>\n"},
  {"section":"indented-code","name":"blank lines inside indented code","md":"    chunk1\n\n    chunk2\n  \n \n \n    chunk3","html":"<pre><code>chunk1\n\nchunk2\n\n\n\nchunk3\n</code></pre>\n"},
  {"section":"blockquote","name":"heading and paragraph in a quote","md":"> # Foo\n> bar\n> baz","html":"<blockquote>\n<h1 id=\"foo\">Foo</h1>\n<p>bar\nbaz</p>\n</blockquote>\n"},
  {"section":"blockquote","name":"lazy continuation","md":"> bar\nbaz\n> foo","html":"<blockquote>\n<p>bar\nbaz\nfoo</p>\n</blockquote>\n"},
  {"section":"blockquote","name":"nested quotes with a lazy line","md":"> > > foo\nbar","html":"<blockquote>\n<blockquote>\n<blockquote>\n<p>foo\nbar</p>\n</blockquote>\n</blockquote>\n</blockquote>\n"},
  {"section":"blockquote","name":"a blank line separates quotes","md":"> foo\n\n> bar","html":"<blockquote>\n<p>foo</p>\n</blockquote>\n<blockquote>\n<p>bar</p>\n</blockquote>\n"},
  {"section":"blockquote","name":"code and list inside a quote","md":"> ```\n> code\n> ```\n> - item","html":"<blockquote>\n<pre><code>code\n</code></pre>\n<ul>\n<li>item</li>\n</ul>\n</blockquote>\n"},
  {"section":"blockquote","name":"empty quote","md":">","html":"<blockquote>\n</blockquote>\n"},
  {"section":"blockquote","name":"nested quote ends at a blank quote line","md":"> a\n>\n> > b\n> c","html":"<blockquote>\n<p>a</p>\n<blockquote>\n<p>b\nc</p>\n</blockquote>\n</blockquote>\n"},
  {"section":"list","name":"tight bullet list","md":"- one\n- two\n- three","html":"<ul>\n<li>one</li>\n<li>two</li>\n<li>three</li>\n</ul>\n"},
  {"section":"list","name":"ordered list with a start number","md":"3. a\n4. b","html":"<ol start=\"3\">\n<li>a</li>\n<li>b</li>\n</ol>\n"},
  {"section":"list","name":"parenthesis delimiter","md":"1) a\n2) b","html":"<ol>\n<li>a</li>\n<li>b</li>\n</ol>\n"},
  {"section":"list","name":"changing the bullet starts a new list","md":"- foo\n- bar\n+ baz","html":"<ul>\n<li>foo</li>\n<li>bar</li>\n</ul>\n<ul>\n<li>baz</li>\n</ul>\n"},
  {"section":"list","name":"blank line between items makes a loose list","md":"- a\n- b\n\n- c","html":"<ul>\n<li>\n<p>a</p>\n</li>\n<li>\n<p>b</p>\n</li>\n<li>\n<p>c</p>\n</li>\n</ul>\n"},
  {"section":"list","name":"blank line between blocks of an item makes the list loose","md":"- a\n- b\n\n  c\n- d","html":"<ul>\n<li>\n<p>a</p>\n</li>\n<li>\n<p>b</p>\n<p>c</p>\n</li>\n<li>\n<p>d</p>\n</li>\n</ul>\n"},
  {"section":"list","name":"three nesting levels","md":"- a\n  - b\n    - c","html":"<ul>\n<li>a\n<ul>\n<li>b\n<ul>\n<li>c</li>\n</ul>\n</li>\n</ul>\n</li>\n</ul>\n"},
  {"section":"list","name":"ordered inside unordered","md":"- a\n  1. b\n  2. c\n- d","html":"<ul>\n<li>a\n<ol>\n<li>b</li>\n<li>c</li>\n</ol>\n</li>\n<li>d</li>\n</ul>\n"},
  {"section":"list","name":"item with code block and quote","md":"1.  A paragraph\n    with two lines.\n\n        indented code\n\n    > A block quote.","html":"<ol>\n<li>\n<p>A paragraph\nwith two lines.</p>\n<pre><code>indented code\n</code></pre>\n<blockquote>\n<p>A block quote.</p>\n</blockquote>\n</li>\n</ol>\n"},
  {"section":"list","name":"too little indentation ends the item","md":"- one\n\n two","html":"<ul>\n<li>one</li>\n</ul>\n<p>two</p>\n"},
  {"section":"list","name":"only an ordered list starting at 1 interrupts a paragraph","md":"The number of windows in my house is\n14.  The number of doors is 6.","html":"<p>The number of windows in my house is\n14.  The number of doors is 6.</p>\n"},
