  {"section":"list","name":"headings inside list items","md":"- # Foo\n- Bar\n  ---\n  baz","html":"<ul>\n<li>\n<h1 id=\"foo\">Foo</h1>\n</li>\n<li>\n<h2 id=\"bar\">Bar</h2>\nbaz</li>\n</ul>\n"},
  {"section":"list","name":"items indented one space more each time","md":"- a\n - b\n  - c\n   - d\n    - e","html":"<ul>\n<li>a</li>\n<li>b</li>\n<li>c</li>\n<li>d\n- e</li>\n</ul>\n"},
  {"section":"list","name":"tabs as indentation","md":" - foo\n   - bar\n\t - baz","html":"<ul>\n<li>foo\n<ul>\n<li>bar\n<ul>\n<li>baz</li>\n</ul>\n</li>\n</ul>\n</li>\n</ul>\n"},
  {"section":"list","name":"tab continues an item","md":"- foo\n\n\tbar","html":"<ul>\n<li>\n<p>foo</p>\n<p>bar</p>\n</li>\n</ul>\n"},
  {"section":"task-list","name":"unchecked and checked","md":"- [ ] foo\n- [x] bar","html":"<ul class=\"contains-task-list\">\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> foo</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" checked disabled> bar</li>\n</ul>\n"},
  {"section":"task-list","name":"uppercase X and nested task lists","md":"- [X] foo\n  - [ ] bar\n- [ ] baz","html":"<ul class=\"contains-task-list\">\n<li class=\"task-list-item\"><input type=\"checkbox\" checked disabled> foo\n<ul class=\"contains-task-list\">\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> bar</li>\n</ul>\n</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> baz</li>\n</ul>\n"},
  {"section":"task-list","name":"loose task list puts the box in the paragraph","md":"- [x] done\n\n- [ ] todo","html":"<ul class=\"contains-task-list\">\n<li class=\"task-list-item\">\n<p><input type=\"checkbox\" checked disabled> done</p>\n</li>\n<li class=\"task-list-item\">\n<p><input type=\"checkbox\" disabled> todo</p>\n</li>\n</ul>\n"},
  {"section":"task-list","name":"look-alikes are not tasks","md":"- [ ]\n- [x]foo\n- [y] bar","html":"<ul>\n<li>[ ]</li>\n<li>[x]foo</li>\n<li>[y] bar</li>\n</ul>\n"},
  {"section":"task-list","name":"ordered task list","md":"1. [x] first\n2. [ ] second","html":"<ol class=\"contains-task-list\">\n<li class=\"task-list-item\"><input type=\"checkbox\" checked disabled> first</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> second</li>\n</ol>\n"},
  {"section":"task-list","name":"task and plain items mixed","md":"- [ ] task\n- plain","html":"<ul class=\"contains-task-list\">\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> task</li>\n<li>plain</li>\n</ul>\n"},
  {"section":"link","name":"inline link with title","md":"[link](/uri \"title\")","html":"<p><a href=\"/uri\" title=\"title\">link</a></p>\n"},
