  {"section":"autolink","name":"spaces are not allowed","md":"<https://foo.bar/baz bim>","html":"<p>&lt;https://foo.bar/baz bim&gt;</p>\n"},
  {"section":"autolink","name":"uppercase mailto scheme","md":"<MAILTO:FOO@BAR.BAZ>","html":"<p><a href=\"MAILTO:FOO@BAR.BAZ\">MAILTO:FOO@BAR.BAZ</a></p>\n"},
  {"section":"autolink","name":"www link without trailing punctuation","md":"Visit www.commonmark.org/help.","html":"<p>Visit <a href=\"http://www.commonmark.org/help\">www.commonmark.org/help</a>.</p>\n"},
  {"section":"autolink","name":"URL link with balanced parentheses","md":"(Visit https://encrypted.google.com/search?q=Markup+(business))","html":"<p>(Visit <a href=\"https://encrypted.google.com/search?q=Markup+(business)\">https://encrypted.google.com/search?q=Markup+(business)</a>)</p>\n"},
  {"section":"autolink","name":"unbalanced closing parentheses are trimmed","md":"www.google.com/search?q=Markup+(business)))","html":"<p><a href=\"http://www.google.com/search?q=Markup+(business)\">www.google.com/search?q=Markup+(business)</a>))</p>\n"},
